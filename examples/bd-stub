#!/usr/bin/env python3
"""Fake `bd` for demos and tests. Stores each issue's notes in $BD_STUB_DIR/<id>.txt.

Supports only:  bd-stub show <id> --json   |   bd-stub update <id> --notes <text>
Fault injection (env):
  BD_STUB_LOSSY=1        `update` keeps only the first 5 chars (simulates a buggy overwrite)
  BD_STUB_SHOW_FAIL=1    `show` exits 1
  BD_STUB_SHOW_EMPTY=1   `show` returns []
  BD_STUB_UPDATE_FAIL=1  `update` exits 1
"""
import json, os, sys

d = os.environ.get("BD_STUB_DIR", ".bd-stub-data")
os.makedirs(d, exist_ok=True)
args = sys.argv[1:]
if len(args) >= 2 and args[0] == "show":
    if os.environ.get("BD_STUB_SHOW_FAIL"):
        print("stub: show failed", file=sys.stderr); sys.exit(1)
    if os.environ.get("BD_STUB_SHOW_EMPTY"):
        print("[]"); sys.exit(0)
    p = os.path.join(d, args[1] + ".txt")
    notes = open(p, encoding="utf-8").read() if os.path.exists(p) else ""
    print(json.dumps([{"id": args[1], "notes": notes}], ensure_ascii=False))
elif len(args) >= 4 and args[0] == "update" and args[2] == "--notes":
    if os.environ.get("BD_STUB_UPDATE_FAIL"):
        print("stub: update failed", file=sys.stderr); sys.exit(1)
    text = args[3]
    if os.environ.get("BD_STUB_LOSSY"):
        text = text[:5]
    with open(os.path.join(d, args[1] + ".txt"), "w", encoding="utf-8") as f:
        f.write(text)
else:
    print("stub: unsupported command", file=sys.stderr); sys.exit(64)
